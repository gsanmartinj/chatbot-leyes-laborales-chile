# Copia este archivo como ".env" y ajusta los valores.

# Contraseña del panel de administración (Gradio). ¡Cámbiala!
ADMIN_PASSWORD=cambia-esta-clave

# (Opcional) Redacción de respuestas con Gemini.
# Si la dejas vacía, la app funciona 100% local (muestra los fragmentos crudos).
# Si defines una clave, Gemini redacta la respuesta a partir de esos fragmentos.
# Consigue una clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (Opcional) Ajustes avanzados
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
